# Optional. When set, Commit City prefers GitHub GraphQL over HTML parsing.
# Create a classic PAT with public access (no extra scopes required for public calendars)
# or a fine-grained token that can read public user contribution data.
# Never put this token in client-side code.
GITHUB_TOKEN=

# Force deterministic mock calendars (useful for UI work without hitting GitHub).
USE_MOCK=false
